# ============================================================================
# CodeVerse Production Environment Variables (Vercel + Supabase)
# ============================================================================

# Public site origin (used for OAuth callbacks & canonical URLs in Vercel)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Supabase Project Credentials (Required in Production)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret — NEVER prefix with NEXT_PUBLIC_ or expose to browser
SUPABASE_SERVICE_ROLE_KEY=

# Strict Production Lockout Flag
# Keep false or unset in production (Vercel) to disable Demo Mode, demo cookies,
# and seeded test vouchers (CODEVERSE20, CODE-TERM-2026, CODE-ALGO-1100).
ALLOW_DEMO_MODE=false

# Phase 3 Gemini API (Server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Phase 4 Bunny.net Stream Video Library (Protected Video Player)
NEXT_PUBLIC_BUNNY_STREAM_LIBRARY_ID=

# Phase 4 Egypt Payment Gateways (Paymob & Fawry)
# In NODE_ENV=production without ALLOW_DEMO_MODE=true, missing secrets cause webhooks to reject with 503.
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=
FAWRY_MERCHANT_CODE=
FAWRY_SECURITY_KEY=

# Phase 5 Rate Limiting (Optional tuning; sensible defaults shown)
RATE_LIMIT_VOUCHER_MAX=5
RATE_LIMIT_VOUCHER_WINDOW_MS=60000
RATE_LIMIT_AI_MAX=5
RATE_LIMIT_AI_WINDOW_MS=60000
